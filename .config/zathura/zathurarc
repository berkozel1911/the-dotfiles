# Kanagawa base + Ayu bright, cyan accent

set font "JetBrainsMono Nerd Font 11"
set selection-clipboard clipboard
set adjust-open "best-fit"
set recolor false
set recolor-keephue true

set default-bg              "#1f1f28"
set default-fg              "#dcd7ba"
set statusbar-bg            "#2a2a37"
set statusbar-fg            "#dcd7ba"
set inputbar-bg             "#1f1f28"
set inputbar-fg             "#dcd7ba"
set notification-bg         "#2a2a37"
set notification-fg         "#dcd7ba"
set notification-error-bg   "#2a2a37"
set notification-error-fg   "#f28779"
set notification-warning-bg "#2a2a37"
set notification-warning-fg "#ffcc66"
set highlight-color         "rgba(255,204,102,0.4)"
set highlight-active-color  "rgba(149,230,203,0.5)"
set completion-bg           "#2a2a37"
set completion-fg           "#dcd7ba"
set completion-highlight-bg "#95e6cb"
set completion-highlight-fg "#1f1f28"
set index-bg                "#1f1f28"
set index-fg                "#dcd7ba"
set index-active-bg         "#2a2a37"
set index-active-fg         "#95e6cb"

# Ctrl+R: dark-mode the document itself
set recolor-lightcolor      "#1f1f28"
set recolor-darkcolor       "#dcd7ba"
